  "dependencies": {
    "@tandem/crdt": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
